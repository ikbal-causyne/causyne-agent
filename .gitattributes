# Auto-detect text files and normalize line endings to LF on checkout and commit
* text=auto eol=lf

# Explicit LF for code, tests, documentation, and configuration
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell scripts on Windows
*.ps1 text eol=crlf
