{
  "//": "Incremental runtime compiler. TypeScript modules emit readable ESM beside their source so the existing JS runtime can import them without a loader or bundler.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": [
    "src/sessionJournal.ts",
    "src/plugins/pluginSkills.ts",
    "src/agentProfiles.ts",
    "src/subagentJournal.ts",
    "src/taskShape.ts",
    "src/hooks.ts",
    "src/approvalGrants.ts",
    "src/planCache.ts",
    "src/decisionPolicy.ts",
    "src/implementationPlan.ts",
    "src/mcp/mcpClient.ts",
    "src/mcp/mcpRegistry.ts",
    "src/browser/urlPolicy.ts",
    "src/browser/snapshotWindow.ts",
    "src/browser/browserRuntime.ts",
    "src/browser/searchProviders.ts",
    "src/browser/causyneBrowser.ts",
    "src/tools/requestDecision.ts",
    "src/tools/updatePlan.ts",
    "src/tools/browserAutomator.ts",
    "src/tools/webSearch.ts",
    "src/tools/webFetch.ts",
    "src/tui/banner.ts",
    "src/tui/setup.ts",
    "src/creative/apps.ts",
    "src/creative/blenderBatch.ts",
    "src/tools/creativeApps.ts",
    "src/creative/studioScripts.ts",
    "src/creative/pipeline.ts",
    "src/dynamicCatalogue.ts",
    "src/computerUse/visionGrounding.ts",
    "src/tools/computerUse.ts",
    "src/uiEngine/uiForge.ts",
    "src/tools/uiForge.ts",
    "src/documentEngine/antiSlopAuditor.ts",
    "src/documentEngine/screenplayFormatter.ts",
    "src/documentEngine/documentForge.ts",
    "src/tools/documentForge.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "scripts",
    "native-skills"
  ]
}
